<Window x:Class="TranslationOverlay.WordScrollOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WordScroll"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        Width="300" Height="500">

    <Border Background="#BB000000"
            CornerRadius="8"
            x:Name="RootBorder">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="26"/>
                <RowDefinition Height="28"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="14"/>
            </Grid.RowDefinitions>

            <!-- タイトルバー（ドラッグ用） -->
            <Border Grid.Row="0"
                    Background="#CC444444"
                    CornerRadius="8,8,0,0"
                    x:Name="DragBar"
                    Cursor="SizeAll"
                    MouseLeftButtonDown="DragBar_MouseLeftButtonDown">
                <TextBlock Text="▶ Word Feed  │ ドラッグで移動"
                           FontSize="10"
                           Foreground="#CCFFFFFF"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False"/>
            </Border>

            <!-- フォントサイズ調整 -->
            <Border Grid.Row="1" Background="#AA222222" Padding="6,2"
                    MouseLeftButtonDown="ControlBar_MouseDown">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                            IsHitTestVisible="True">
                    <TextBlock Text="字" Foreground="#88FFFFFF" FontSize="10"
                               VerticalAlignment="Center" Margin="0,0,4,0"
                               IsHitTestVisible="False"/>
                    <Slider x:Name="FontSlider"
                            Minimum="8" Maximum="28" Value="12"
                            Width="120"
                            VerticalAlignment="Center"
                            TickFrequency="1" IsSnapToTickEnabled="True"
                            ValueChanged="FontSlider_ValueChanged"
                            IsHitTestVisible="True"/>
                    <TextBlock x:Name="FontSizeLabel"
                               Text="12px"
                               Foreground="#AAFFFFFF"
                               FontSize="10"
                               VerticalAlignment="Center"
                               Margin="6,0,0,0"
                               IsHitTestVisible="False"/>
                </StackPanel>
            </Border>

            <!-- 本文スクロール -->
            <ScrollViewer Grid.Row="2"
                          x:Name="Scroller"
                          VerticalScrollBarVisibility="Hidden"
                          HorizontalScrollBarVisibility="Disabled"
                          IsHitTestVisible="False">
                <StackPanel x:Name="WordList"
                            Margin="8,4,8,4"/>
            </ScrollViewer>

            <!-- リサイズハンドル（右下） -->
            <Border Grid.Row="3"
                    Background="#88555555"
                    CornerRadius="0,0,8,8"
                    x:Name="ResizeHandle"
                    Cursor="SizeNWSE"
                    HorizontalAlignment="Right"
                    Width="30" Height="14"
                    MouseLeftButtonDown="ResizeHandle_MouseLeftButtonDown">
                <TextBlock Text="⤡" Foreground="#AAFFFFFF" FontSize="10"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           IsHitTestVisible="False"/>
            </Border>

        </Grid>
    </Border>
</Window>
