<Window x:Class="TranslationOverlay.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="リアルタイム翻訳"
        Height="300" Width="440"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">

    <StackPanel Margin="24" VerticalAlignment="Center">

        <TextBlock Text="🎙 リアルタイム翻訳オーバーレイ"
                   FontSize="16" FontWeight="Bold"
                   Margin="0,0,0,20"/>

        <!-- 翻訳方向 -->
        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="翻訳方向：" Width="80" VerticalAlignment="Center"/>
            <ComboBox x:Name="LangCombo" Width="180" SelectedIndex="0">
                <ComboBoxItem Content="英語 → 日本語"/>
                <ComboBoxItem Content="日本語 → 英語"/>
            </ComboBox>
        </StackPanel>

        <!-- モデルパス表示 -->
        <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
            <TextBlock Text="モデル：" Width="80" VerticalAlignment="Center"/>
            <TextBlock x:Name="ModelPathText"
                       Text="models\vosk-model-en-us-0.22-lgraph"
                       FontSize="11" Foreground="Gray"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       MaxWidth="300"/>
        </StackPanel>

        <!-- ステータス -->
        <TextBlock x:Name="StatusText"
                   Text="● 停止中"
                   FontSize="13"
                   Foreground="Gray"
                   Margin="0,0,0,20"/>

        <!-- ボタン -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <Button x:Name="StartBtn"
                    Content="▶ 開始"
                    Width="110" Height="38"
                    Margin="0,0,10,0"
                    Click="StartBtn_Click"/>
            <Button x:Name="StopBtn"
                    Content="■ 停止"
                    Width="110" Height="38"
                    IsEnabled="False"
                    Click="StopBtn_Click"/>
        </StackPanel>

    </StackPanel>
</Window>
